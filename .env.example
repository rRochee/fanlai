# 饭来 FanLai · 环境变量示例
#
# 复制为 .env 后按需修改：cp .env.example .env
# 不配置也能运行——Prisma 会回落到仓库自带的 db/custom.db（已内置演示数据）。

# SQLite 数据库位置。默认使用仓库自带的演示数据库，开箱即用。
DATABASE_URL="file:./db/custom.db"

# 设为 1 可关闭每日名录的自动联网同步。
# 该功能依赖特定 SDK 环境；缺少配置时情报管道会失败，
# 设为 1 可避免调度器反复打印「推送失败」日志。
# 关闭后记录、核对、看板、日历等核心功能不受影响，仍可在页面内手动同步。
FANLAI_DISABLE_AUTO=1

# logo 预热脚本访问本机服务时使用的基地址。
LOGO_BASE_URL="http://localhost:3000"